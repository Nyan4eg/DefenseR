{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DefenseR",
  "version": "0.12.1",
  "identifier": "com.defenser.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DefenseR",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMkM5MkVGMzNCMzM2NDQKUldSRU5yTXo3NUlzVENQRjNIRmczS3JJS2FuRE83R3hnRExnblp3WWxDV1JML1lUTXF4dWtmRkIK",
      "endpoints": [
        "https://github.com/Nyan4eg/DefenseR/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
